{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "rootDir": "./",
    "outDir": "./dist",
    "esModuleInterop": true,
    "moduleResolution": "node16",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "ignoreDeprecations": "6.0"
  },
  "exclude": ["node_modules", "dist"]
}